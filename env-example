#------------------------------------------------------------------------------
# Dokploy-Private-DoH — environment
#
# Dokploy: paste these into the compose app's "Environment" tab.
# Elsewhere: cp env-example .env and edit.
#
# Values are read directly from the .env file by config-init.sh, so `$` signs
# (bcrypt hashes) need NO escaping and no quotes.
# After changing anything here, redeploy — the configs are regenerated on start.
#------------------------------------------------------------------------------

# --- Endpoint -----------------------------------------------------------------

# Apex domain only. The endpoint becomes https://<DOH_SUBDOMAIN>.<DOMAIN>/dns-query
DOMAIN=example.com

# Subdomain label for the endpoint. Needs a DNS A/AAAA record pointing at the server.
DOH_SUBDOMAIN=resolver

# --- Authentication (set at least one method; both is fine) -------------------

# Secret path — works with every DoH client (Windows 11, browsers, iOS, Android,
# YogaDNS, Little Snitch). Clients use:
#   https://resolver.example.com/dns-query/<DOH_SECRET_PATH>
# Generate: openssl rand -hex 24
# Treat it like a password. Rotate by changing it and redeploying.
DOH_SECRET_PATH=

# HTTP Basic Auth — for clients with username/password fields (Little Snitch,
# YogaDNS, curl -u). Clients use https://resolver.example.com/dns-query
# Generate the hash:  htpasswd -nbB myuser 'a-long-random-password'
#   (htpasswd is in apache2-utils / httpd-tools; on macOS it is preinstalled)
# Paste only the part after "myuser:" below. Clients get the PLAIN password, never the hash.
DOH_USER=
DOH_HASHED_PASS=

# --- Upstreams ----------------------------------------------------------------

# Your NextDNS profile ID: NextDNS dashboard → Setup tab → "Endpoints" → ID
# (the short code in https://dns.nextdns.io/<ID>). Used first; your NextDNS
# blocklists, logs and settings apply. Leave empty to skip NextDNS.
NEXTDNS_ID=

# Tried in order, only when the previous upstream fails or times out (2s).
# Comma-separated. Formats: https://host/path (DoH), tcp-tls:host (DoT), quic:host (DoQ).
# NOTE: NextDNS blocklists do not apply to queries answered by fallbacks.
FALLBACK_UPSTREAMS=https://cloudflare-dns.com/dns-query,https://dns.quad9.net/dns-query

# --- Cloudflare ---------------------------------------------------------------

# Is the resolver record proxied (orange cloud)?
#   true  = accept only Cloudflare (mTLS); direct hits on the server IP fail.
#           Needs: Cloudflare → SSL/TLS → Origin Server → Authenticated Origin Pulls ON.
#   false = grey cloud / no Cloudflare.
CLOUDFLARE_PROXY=false

# --- Traefik (defaults match Dokploy) -----------------------------------------

# HTTPS entrypoint name in Traefik.
TRAEFIK_ENTRYPOINT=websecure

# Who provides the TLS certificate?
#   letsencrypt = Traefik gets one from Let's Encrypt (any ACME resolver name works).
#   empty       = use a certificate already added in Dokploy → Settings → Certificates
#                 (e.g. a Cloudflare Origin cert; orange cloud + Full (strict) only).
TRAEFIK_CERT_RESOLVER=letsencrypt

# Traefik's file-provider directory (same path on the host and in the container).
TRAEFIK_DYNAMIC_DIR=/etc/dokploy/traefik/dynamic
